@model IEnumerable<Product>

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Product List</h2>
        </div>

        <div class="col-6 text-end">
            <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create a New Product
            </a>
        </div>
    </div>
</div>

<h3>List of SBD Product list</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Category Title</th>
            <th>Description</th>
            <th>ISBN</th>
            <th>Author</th>
            <th>List Price</th>
            <th>Price</th>
            <th>Price 50</th>
            <th>Price 100</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Title</td>
                    <td>@obj.Description</td>
                    <td>@obj.SKU</td>
                    <td>@obj.Author</td>
                    <td>@obj.ListPrice</td>
                    <td>@obj.Price</td>
                    <td>@obj.Price50</td>
                    <td>@obj.Price100</td>
                    <td>
                        <div class="w-100 btn-group" role="group">
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-primary mx-1">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-1">
                                <i class="bi bi-trash"></i>
                            </a>

                            <form asp-controller="Product" asp-action="ClearTitle" asp-route-id="@obj.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning mx-1">
                                    Clear Title
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center">No data available</td>
            </tr>
        }
    </tbody>
</table>